// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String  
  email    String   @unique
  password String
  userrole String @default("guest")
  isActive Boolean @default(false)
}

model Page {
  id       Int      @id @default(autoincrement())
  title    String  
  content  String 
  path     String
  metadata String
  html     String
  active   String
  js       String
  css      String
  authors  String
  userId   Int
}

model Product {
  id       Int      @id @default(autoincrement())
  title    String  
  content  String
  vendor   String
  type     String
  price    Int
  tax      Int
  origin   String
  discout  Int  
  avlcount Int
  userId   Int
  assets   String
  path     String
  manual   String
  tag      String @default("")
}

model Order {
  id       Int      @id @default(autoincrement())
  productList Json?
  productIds String
  orderDate DateTime @db.Date
  userId Int
  userEmail String
  userPhone String
  orderAmt Int
  tax Int
  invoiceJson Json?
  invoicePath String
  orderTotal Int
  paymentStatus Boolean
  orderStatus String
  paymentDate DateTime @db.Date
  transectionId String
  remakrs String
}

model userproduct {
  id       Int      @id @default(autoincrement())
  userId   Int
  productId Int
  cred String
  startDt DateTime @db.Date
  endDt DateTime @db.Date
  remakrs String
  isActive Boolean
  }